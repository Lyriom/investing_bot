# ---------------------------------------------------------------------------
# investing_bot — plantilla de configuracion
#
# Copiar a `.env` y rellenar. El archivo `.env` esta en .gitignore y NUNCA
# debe entrar al repositorio (invariante I5). Si un secreto se filtra alguna
# vez, se rota de inmediato.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Entorno ---------------------------------------------------------------
ENTORNO=desarrollo
NIVEL_LOG=INFO

# --- Base de datos ---------------------------------------------------------
# En docker compose el host es el nombre del servicio: `db`.
# Para correr contra la BD del compose desde el host, usar POSTGRES_HOST=localhost.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=investing_bot
POSTGRES_USER=investing
POSTGRES_PASSWORD=

# Opcional: sobreescribe por completo la URL construida a partir de lo anterior.
# Se acepta tal cual la cadena que entregan los paneles (Easypanel, Railway,
# Heroku) en formato `postgres://...`: el driver se reescribe solo.
# URL_BD=postgresql+asyncpg://usuario:clave@host:5432/investing_bot

# --- Arranque en plataformas sin `depends_on` (Easypanel, Railway) ---------
# En docker compose no hacen falta: el orden lo resuelven los healthchecks.
# Ver docs/easypanel.md.
# ESPERAR_BD=true             # esperar a que PostgreSQL acepte consultas
# ESPERAR_BD_TIMEOUT=90       # plazo maximo de esa espera, en segundos
# EJECUTAR_MIGRACIONES=true   # aplicar Alembic y sembrar; SOLO en un servicio
# SERVICIO=todo               # todo | api | bot | planificador
#   `todo` corre los tres en un proceso: un solo servicio que configurar, a
#   cambio de que un fallo en cualquiera reinicie a los tres.

# --- Telegram --------------------------------------------------------------
# Token que entrega @BotFather.
TELEGRAM_BOT_TOKEN=
# Unico chat_id que el bot atiende. Cualquier otro recibe silencio, no un error.
# Para averiguarlo: escribirle al bot y mirar los logs, o usar @userinfobot.
TELEGRAM_CHAT_ID_AUTORIZADO=0

# --- Servidor web ----------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PUERTO=8000

# --- Parametros de riesgo (provisionales, ver invariante I4) ---------------
# Fijos y arbitrarios a proposito. NO se optimizan hasta tener backtester (FASE 2).
CAPITAL_TOTAL_USD=150
MAX_POSICIONES_ABIERTAS=5
MIN_TAMANO_POSICION_USD=50
MAX_PCT_POR_POSICION=0.25
MAX_POSICIONES_POR_SECTOR=2
STOP_LOSS_PCT=0.08
MAX_PERDIDA_MENSUAL_PCT=0.10
MIN_VOLUMEN_DIARIO=1000000
MIN_PRECIO_ACCION=5.00
MAX_SUGERENCIAS_POR_DIA=2
DIAS_COOLDOWN_MISMO_TICKER=5
COSTO_CLEARING_USD=0.15
SPREAD_ESTIMADO_PCT=0.001
MAX_COSTO_FRICCION_PCT=0.01

# --- Ingesta ---------------------------------------------------------------
# La senal de regimen necesita 200 barras de SPY: con 90 dias no se puede medir
# y el sistema entra en modo defensivo. Para operar de verdad, 400.
DIAS_HISTORIAL_PRECIOS_INICIAL=400
DIAS_HISTORIAL_CONGRESO=180
DIAS_HISTORIAL_NOTICIAS=7
HORAS_VENTANA_REDDIT=24
SUBREDDITS=wallstreetbets,stocks,investing

# Fuentes del Congreso. Los datasets de stock-watcher devuelven 403 desde
# agosto de 2026; se dejan configurables para poder apuntar a un espejo.
# URL_CONGRESO_CAMARA=
# URL_CONGRESO_SENADO=
REINTENTOS_MAX=4
BACKOFF_BASE_SEG=1.5

# --- Zonas horarias --------------------------------------------------------
ZONA_HORARIA_MERCADO=America/New_York
ZONA_HORARIA_OPERADOR=America/Guayaquil

# --- Senales (provisionales, invariante I4) -------------------------------
# NO se optimizan hasta tener el backtester de la FASE 2 validado.
VERSION_MODELO=pesos-v1
PESO_DERIVA_NOTICIAS=0.40
PESO_VELOCIDAD_REDDIT=0.25
PESO_CONSENSO_CONGRESO=0.15
UMBRAL_SUGERENCIA=60

# --- Claves de fuentes externas -------------------------------------------
# Sin FINNHUB_API_KEY no hay senal de deriva post-noticia (finnhub.io/register).
FINNHUB_API_KEY=

# Marketaux (marketaux.com/register) es el RESPALDO de las noticias: solo se
# consulta para los tickers donde Finnhub no trajo nada o fallo. Alimenta la
# MISMA senal S1 — dos agregadores de titulares no son fuentes independientes,
# asi que no suma peso, suma cobertura. El plan gratuito da 100 peticiones al
# dia y 3 articulos por peticion; MAX_PETICIONES_MARKETAUX_DIA lo respeta.
MARKETAUX_API_KEY=
# MAX_PETICIONES_MARKETAUX_DIA=90

# Sin las de Reddit no hay senal de velocidad (reddit.com/prefs/apps, tipo
# script). Desde junio de 2026 crear la app NO da acceso: hay que solicitarlo
# aparte y esperar aprobacion.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=investing_bot/0.1 por u/tu_usuario
